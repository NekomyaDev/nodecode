# Compiled output. ASDF writes fasls to its cache by default, but a local
# build or a --script run can drop them beside the source.
*.fasl
*.fas
*.lib
*.o
*.so

# Image snapshots and genome generations (A6). These are build products of the
# organism's own evolution, not source. The genome text file is the diffable
# lineage; cores are large and machine-specific.
*.core
generations/

# Durable transcript store (A3).
*.db
*.db-journal
*.db-wal
*.db-shm

# Unix socket endpoints (A1).
*.sock

# Local operator scratch.
.scratch/
